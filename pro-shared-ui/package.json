    "test:project-bundle": "esbuild tests/projectBundleTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/project-bundle-test.mjs && node dist/project-bundle-test.mjs",
    "test:project-saves": "esbuild tests/projectSaveCoordinatorTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/project-saves-test.mjs && node dist/project-saves-test.mjs",
