    "test:scene-saves": "esbuild tests/sceneSaveQueueTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/scene-saves-test.mjs && node dist/scene-saves-test.mjs",
    "test:comment-anchors": "esbuild tests/commentAnchorTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/comment-anchor-test.mjs && node dist/comment-anchor-test.mjs",
    "test:title-comment-highlights": "esbuild tests/titleCommentHighlightTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/title-comment-highlight-test.mjs && node dist/title-comment-highlight-test.mjs",
    "test:manuscript-viewport": "esbuild tests/manuscriptViewportTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/manuscript-viewport-test.mjs && node dist/manuscript-viewport-test.mjs",
