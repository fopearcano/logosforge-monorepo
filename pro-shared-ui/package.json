{
  "name": "@logosforge/pro-shared-ui",
  "version": "0.1.6",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "description": "LogosForge Studio (Pro) shared React UI — a dockable, cinematic writing workstation over the logosforge core. Platform-neutral; consumed by pro-desktop (Electron) and pro-web (browser). Owns the Studio visual identity. Never shares UI with the Whiteboard (Free) line.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p preview/tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:skins && npm run test:commands && npm run test:omnibox && npm run test:omnibox-async && npm run test:panel-navigation && npm run test:scene-navigator && npm run test:structure-placement && npm run test:structure-authoring && npm run test:timeline-transactions && npm run test:timeline-panel && npm run test:canvas-plot-geometry && npm run test:canvas-plot-transactions && npm run test:canvas-plot-panel && npm run test:progressions && npm run test:knowledge-graph && npm run test:decision-radar && npm run test:continuity-panel && npm run test:guided-workflows && npm run test:panel-catalog && npm run test:preview-workspace && npm run test:workspace-layout && npm run test:workspace-persistence && npm run test:workspace-interactions && npm run test:workspace-render && npm run test:http-api && npm run test:runtime-dto && npm run test:http-lifetime && npm run test:client-lifetime && npm run test:get-coalescing && npm run test:preview-api && npm run test:project-bundle && npm run test:project-saves && npm run test:project-save-status && npm run test:workspace-status && npm run test:live-context && npm run test:scene-saves && npm run test:comment-anchors && npm run test:title-comment-highlights && npm run test:manuscript-viewport && npm run test:controlled-apply && npm run test:latest-request && npm run test:extraction-polling && npm run test:extraction-session && npm run test:series-snapshot && npm run test:runtime-faults && npm run test:mic-lifecycle && npm run test:comments && npm run test:lifecycle && npm run test:accessibility",
    "test:skins": "esbuild tests/skinTests.tsx --bundle --format=esm --platform=node --log-level=error --outfile=dist/skin-test.mjs && node dist/skin-test.mjs",
    "test:commands": "esbuild tests/commandRegistryTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/command-registry-test.mjs && node dist/command-registry-test.mjs",
    "test:omnibox": "esbuild tests/omniboxTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/omnibox-test.mjs && node dist/omnibox-test.mjs",
    "test:omnibox-async": "esbuild tests/studioOmniboxAsyncTests.tsx --bundle --format=esm --platform=node --log-level=error --outfile=dist/studio-omnibox-async-test.mjs && node dist/studio-omnibox-async-test.mjs",
    "test:panel-navigation": "esbuild tests/panelNavigationTargetTests.tsx --bundle --format=esm --platform=node --log-level=error --outfile=dist/panel-navigation-target-test.mjs && node dist/panel-navigation-target-test.mjs",
