    "test:progressions": "esbuild tests/progressionsTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/progressions-test.mjs && node dist/progressions-test.mjs",
    "test:knowledge-graph": "esbuild tests/knowledgeGraphTests.tsx --bundle --format=esm --platform=node --log-level=error --outfile=dist/knowledge-graph-test.mjs && node dist/knowledge-graph-test.mjs",
