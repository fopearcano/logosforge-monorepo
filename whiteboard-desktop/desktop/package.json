{
  "name": "logosforge-whiteboard-desktop",
  "version": "0.1.14",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "description": "LogosForge Whiteboard — Electron + React + TypeScript desktop shell",
  "author": "LogosForge",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite renderer",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && nodemon --watch electron --ext ts --exec \"npm run build:electron && electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "npm run build && electron . --prod",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "npm run typecheck && npm run test:mcp-runtime && npm run test:mcp-packaging && npm run test:runtime-faults && npm run test:renderer-save-gate && npm run test:shutdown-persistence && npm run test:pending-persistence && npm run test:document-delete-transaction && npm run test:atomic-file-save && npm run test:import-file-limit && npm run test:accessibility && npm run test:editor-recovery && npm run test:outline-recovery && npm run test:api-errors && npm run test:resource-revisions && npm run test:path-grants && npm run test:document-state && npm run test:document-settings && npm run test:block-ids && npm run test:screenplay && npm run test:paginate && npm run test:editor-tools && npm run test:files && npm run test:themes && npm run test:outline && npm run test:comments && npm run test:import-export && npm run test:littleboy && npm run test:settings && npm run test:gn && npm run test:stage",
    "test:mcp-runtime": "esbuild tests/mcpRuntimeTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/mcp-runtime-test.mjs && node dist/mcp-runtime-test.mjs",
    "test:mcp-packaging": "esbuild tests/mcpPackagingTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/mcp-packaging-test.mjs && node dist/mcp-packaging-test.mjs",
    "test:runtime-faults": "esbuild tests/runtimeFaultTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/runtime-fault-test.mjs && node dist/runtime-fault-test.mjs",
    "test:renderer-save-gate": "esbuild tests/rendererSaveGateTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/renderer-save-gate-test.mjs && node dist/renderer-save-gate-test.mjs",
    "test:shutdown-persistence": "esbuild tests/shutdownPersistenceTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/shutdown-persistence-test.mjs && node dist/shutdown-persistence-test.mjs",
    "test:pending-persistence": "esbuild tests/pendingDocumentPersistenceTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/pending-persistence-test.mjs && node dist/pending-persistence-test.mjs",
    "test:document-delete-transaction": "esbuild tests/documentDeleteTransactionTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/document-delete-transaction-test.mjs && node dist/document-delete-transaction-test.mjs",
    "test:atomic-file-save": "esbuild tests/atomicFileSaveTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/atomic-file-save-test.mjs && node dist/atomic-file-save-test.mjs",
    "test:import-file-limit": "esbuild tests/importFileLimitTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/import-file-limit-test.mjs && node dist/import-file-limit-test.mjs",
    "test:accessibility": "esbuild tests/accessibilityTests.ts --bundle --format=esm --platform=node --external:typescript --log-level=error --outfile=dist/accessibility-test.mjs && node dist/accessibility-test.mjs",
    "test:editor-recovery": "esbuild renderer/src/features/whiteboard/editorRecoveryTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/editor-recovery-test.mjs && node dist/editor-recovery-test.mjs",
    "test:outline-recovery": "esbuild renderer/src/features/outline/outlineRecoveryTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/outline-recovery-test.mjs && node dist/outline-recovery-test.mjs",
    "test:api-errors": "esbuild renderer/src/api/responseErrorTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/api-errors-test.mjs && node dist/api-errors-test.mjs",
    "test:resource-revisions": "esbuild renderer/src/api/resourceRevisionTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/resource-revisions-test.mjs && node dist/resource-revisions-test.mjs",
    "test:path-grants": "esbuild tests/pathGrantsTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/path-grants-test.mjs && node dist/path-grants-test.mjs",
    "test:document-state": "esbuild renderer/src/state/currentDocumentTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/document-state-test.mjs && node dist/document-state-test.mjs",
    "test:document-settings": "esbuild renderer/src/features/whiteboard/documentSettingsTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/document-settings-test.mjs && node dist/document-settings-test.mjs",
    "test:block-ids": "esbuild renderer/src/features/whiteboard/blockIdentityTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/block-ids-test.mjs && node dist/block-ids-test.mjs",
    "test:screenplay": "esbuild renderer/src/features/screenplay/screenplayTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/screenplay-test.mjs && node dist/screenplay-test.mjs",
    "test:paginate": "esbuild renderer/src/features/screenplay/screenplayPaginateTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/paginate-test.mjs && node dist/paginate-test.mjs",
    "test:gn": "esbuild renderer/src/features/graphicNovel/graphicNovelTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/gn-test.mjs && node dist/gn-test.mjs",
    "test:stage": "esbuild renderer/src/features/stage/stageTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/stage-test.mjs && node dist/stage-test.mjs",
    "test:editor-tools": "esbuild renderer/src/features/editorTools/editorToolsTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/editor-tools-test.mjs && node dist/editor-tools-test.mjs",
    "test:files": "esbuild renderer/src/features/files/filesTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/files-test.mjs && node dist/files-test.mjs",
    "test:themes": "esbuild renderer/src/styles/themes/themesTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/themes-test.mjs && node dist/themes-test.mjs",
    "test:outline": "esbuild renderer/src/features/outline/outlineTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/outline-test.mjs && node dist/outline-test.mjs",
    "test:comments": "esbuild renderer/src/features/comments/commentsAnchorTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/comments-test.mjs && node dist/comments-test.mjs",
    "test:import-export": "esbuild renderer/src/features/files/importExportTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/import-export-test.mjs && node dist/import-export-test.mjs",
    "test:littleboy": "esbuild renderer/src/features/littleboy/littleboyTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/littleboy-test.mjs && node dist/littleboy-test.mjs",
    "test:settings": "esbuild renderer/src/features/settings/settingsTests.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/settings-test.mjs && node dist/settings-test.mjs",
    "test:packaged": "node scripts/packaged-acceptance.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.1",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.7",
    "playwright-core": "1.63.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "wait-on": "^8.0.1"
  }
}
